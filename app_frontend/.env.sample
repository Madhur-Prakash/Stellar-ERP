# ---- Desktop client configuration -------------------------------------------
# Copy to `.env` (`make setup` does it for you) and edit. Read at start-up by
# flutter_dotenv, so a change takes a restart - not a rebuild.
#
# `.env` is bundled into the application as an asset, which means two things:
# it must exist before `flutter build` runs, and anything in it ships to whoever
# has the binary. Keep secrets out. The three values below are a host, a path and
# a display name - all of which the client discloses in its first request anyway.

# Where the API lives.
#
# `127.0.0.1`, not `localhost`. `docker compose` can publish the API on IPv4 only,
# and `localhost` on Windows resolves to `::1` first, so a client that takes the
# first answer gets "connection refused" from a server that is running perfectly
# well. Worse, a failed session restore is indistinguishable from "not signed in",
# so it presents as the sign-in screen with no explanation. Naming the address
# family removes the guess.
API_BASE_URL=http://127.0.0.1:8000

# The versioned path prefix, joined onto the base URL. Must start with "/".
API_V1_PREFIX=/api/v1

# Shown in the window title and the footer.
APP_NAME=Stellar ERP
